
FROM mcr.microsoft.com/dotnet/sdk:9.0
WORKDIR /src
COPY . .
RUN dotnet restore

RUN dotnet build "SharpFastFloat.Benchmarks/SharpFastFloat.Benchmarks.csproj" -c Release -o /src/bin
RUN dotnet publish "SharpFastFloat.Benchmarks/SharpFastFloat.Benchmarks.csproj" -c Release -o /src/bin/publish

WORKDIR /src/bin/publish
ENTRYPOINT ["dotnet", "SharpFastFloat.Benchmarks.dll"]
