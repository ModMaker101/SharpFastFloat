
FROM mcr.microsoft.com/dotnet/sdk:9.0
WORKDIR /src
COPY . .
RUN dotnet restore

RUN dotnet build "SharpFastFloat.BenchmarkHandCoded/SharpFastFloat.BenchmarkHandCoded.csproj" -c Release -o /src/bin
RUN dotnet publish "SharpFastFloat.BenchmarkHandCoded/SharpFastFloat.BenchmarkHandCoded.csproj" -c Release -o /src/bin/publish

WORKDIR /src/bin/publish
ENTRYPOINT ["dotnet", "SharpFastFloat.BenchmarkHandCoded.dll"]
